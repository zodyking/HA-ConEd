#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# ConEd Scraper - Prisma Studio (Database UI)
# ==============================================================================

exec 2>&1

export DATABASE_URL="postgresql://coned:coned@localhost:5432/coned"

cd /app/python-service

# Wait for PostgreSQL and coned database to be ready
bashio::log.info "Waiting for PostgreSQL before Prisma Studio..."
until PGPASSWORD=coned psql -h localhost -p 5432 -U coned -d coned -t -c "SELECT 1" > /dev/null 2>&1; do
    sleep 2
done
sleep 2
bashio::log.info "PostgreSQL is ready, starting Prisma Studio on port 5555..."
exec prisma studio --port 5555 --browser none
