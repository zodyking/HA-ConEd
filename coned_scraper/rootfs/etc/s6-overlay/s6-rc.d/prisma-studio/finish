#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# ConEd Scraper - Prisma Studio service finish (NON-CRITICAL)
# Prisma Studio is optional - if it fails, don't crash the whole addon
# ==============================================================================
readonly exit_code_service="${1}"
readonly exit_code_signal="${2}"
readonly service="prisma-studio"

bashio::log.info "Service ${service} exited with code ${exit_code_service} (by signal ${exit_code_signal})"

# Only restart if it was a clean exit or signal 15 (SIGTERM)
if [[ "${exit_code_service}" -eq 0 ]] || [[ "${exit_code_signal}" -eq 15 ]]; then
  bashio::log.info "Service ${service} stopped normally"
else
  bashio::log.warning "Service ${service} failed - Prisma Studio is optional, addon will continue"
fi

# Never halt the container for Prisma Studio failures
