#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# ConEd Scraper - Python API (FastAPI + Playwright)
# ==============================================================================

bashio::log.info "Starting Con Edison API..."

export PLAYWRIGHT_HEADLESS=true
export PYTHONUNBUFFERED=1
export DATA_DIR=/config
export DATABASE_URL="postgresql://coned:coned@localhost:5432/coned"

cd /app/python-service

# Wait for PostgreSQL to be ready
bashio::log.info "Waiting for PostgreSQL to be ready..."
while ! pg_isready -h localhost -p 5432 -U coned > /dev/null 2>&1; do
    sleep 1
done
bashio::log.info "PostgreSQL is ready!"

# Run Prisma migrations to ensure database schema is up to date
bashio::log.info "Running Prisma database migrations..."
python3 -m prisma db push --accept-data-loss 2>&1 || {
    bashio::log.warning "Prisma migration had issues, continuing anyway..."
}

bashio::log.info "Starting FastAPI server..."
exec python3 -m uvicorn main:app --host 0.0.0.0 --port 8000
