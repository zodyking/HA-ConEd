#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# ConEd Scraper - Python API (FastAPI + Playwright)
# ==============================================================================

# Fixed ports (internal use)
API_PORT="8000"
POSTGRES_PORT="5432"

bashio::log.info "============================================"
bashio::log.info "CON EDISON API SERVICE v1.3.48"
bashio::log.info "============================================"
bashio::log.info "API Port: ${API_PORT}, PostgreSQL Port: ${POSTGRES_PORT}"

export PLAYWRIGHT_HEADLESS=true
export PYTHONUNBUFFERED=1
export DATA_DIR=/config
export DATABASE_URL="postgresql://coned:coned@localhost:${POSTGRES_PORT}/coned"

cd /app/python-service

# Wait for PostgreSQL to be ready AND coned user/database to exist
bashio::log.info "Waiting for PostgreSQL and coned database..."
until PGPASSWORD=coned psql -h localhost -p "${POSTGRES_PORT}" -U coned -d coned -t -c "SELECT 1" > /dev/null 2>&1; do
    sleep 1
done
sleep 3
bashio::log.info "PostgreSQL is ready!"

# Run Prisma migrations to ensure database schema is up to date
bashio::log.info "Running Prisma database migrations..."
python3 -m prisma db push --accept-data-loss 2>&1 || {
    bashio::log.warning "Prisma migration had issues, continuing anyway..."
}

bashio::log.info "Starting FastAPI server on port ${API_PORT}..."
exec python3 -m uvicorn main:app --host 0.0.0.0 --port "${API_PORT}"
